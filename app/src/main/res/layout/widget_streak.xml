<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widgetStreakRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#ffffff"
    android:padding="5dp"
    app:cardCornerRadius="@dimen/popupStreakCornerRadius_45dp"
    >
    <ImageView
        android:id="@+id/popupStreakImage"
        android:layout_width="@dimen/widgetImageWidth_100dp"
        android:layout_height="@dimen/widgetImageHeight_100dp"
        android:src="@drawable/image_cat_streak_0"
        android:cropToPadding="true"
        android:contentDescription="@string/contentDescriptionPopupStreak"
        />

    <TextView
        android:id="@+id/popupStreakCount"
        style="@style/TextAppearance.Material3.HeadlineSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="@dimen/popupStreakTextSize_16sp"
        android:textColor="@color/onSurface"
        />

    <TextView
        android:id="@+id/popupStreakDescription"
        style="@style/TextAppearance.Material3.HeadlineSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/popupStreakDescription"
        android:textSize="@dimen/popupStreakTextSize_16sp"
        android:textColor="@color/onSurface"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="4dp"
        />

</LinearLayout>