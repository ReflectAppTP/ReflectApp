<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.widget.fragment.WidgetFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/fragmentWidgetToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:layout_marginHorizontal="@dimen/mainFragmentViewPagerToolbarMarginHorizontal_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/fragmentWidgetToolbarTitle"
            style="@style/TextAppearance.Material3.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Виджеты"
            android:layout_gravity="center"
            android:textColor="@color/onSurface"
            />

        <ImageButton
            android:id="@+id/fragmentWidgetToolbarBackArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:background="@drawable/rounded_surface_ripple"
            android:contentDescription="Иконка возврата на экран профиля"
            android:src="@drawable/ic_back_arrow" />

    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/fragmentWidgetToggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fragmentStatisticToggleGroupMarginHorizontal_11dp"
        app:singleSelection="true"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/fragmentWidgetToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fragmentWidgetStreakButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_weight="1"
            android:text="Стрик пользователя"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fragmentWidgetStateButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_weight="1"
            android:text="Эмоциональное состояние"
            />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fragmentWidgetScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/background_scroll_view_widget"
        android:layout_marginVertical="29dp"
        android:layout_marginHorizontal="25dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragmentWidgetToggleGroup"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible"
            android:gravity="center_horizontal"
            >

            <LinearLayout
                android:id="@+id/fragmentWidgetStreakLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_streak_preview_2"
                    android:contentDescription="Превью стрика, когда записей нет"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_streak_preview_1"
                    android:contentDescription="Превью стрика, когда записей меньше 7"
                    android:layout_marginVertical="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_streak_preview_3"
                    android:contentDescription="Превью стрика, когда записей больше 7"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fragmentWidgetStateLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                >
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_state_preview_1"
                    android:contentDescription="Превью стрика, когда состояние ужасное"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_state_preview_2"
                    android:contentDescription="Превью стрика, когда состояние плохое"
                    android:layout_marginVertical="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_state_preview_3"
                    android:contentDescription="Превью стрика, когда состояние нормальное"
                    android:layout_marginVertical="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_state_preview_4"
                    android:contentDescription="Превью стрика, когда состояние хорошее"
                    android:layout_marginVertical="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_state_preview_5"
                    android:contentDescription="Превью стрика, когда состояние замечательное"
                    android:layout_marginVertical="10dp"
                    />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/image_widget_state_preview_6"
                    android:contentDescription="Превью стрика, когда пользователь не отметил запись состояния"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>