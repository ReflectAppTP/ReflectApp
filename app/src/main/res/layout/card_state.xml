<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="23dp"
    style="@style/Widget.Material3.CardView.Outlined"
    app:strokeColor="@color/outlineVariant"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardElevation="4dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/dialogMarginVertical_4dp"
        android:layout_gravity="center"
        >

        <androidx.cardview.widget.CardView
            android:id="@+id/cardStateImageCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:cardCornerRadius="45dp"
            app:cardBackgroundColor="@color/primary"
            >

            <ImageView
                android:id="@+id/cardStateImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_state_image_1"
                android:contentDescription="Иконка, показывающая состояние" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/cardStateChangeMoodTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/onSurface"
            android:layout_marginStart="16dp"
            tools:text="Хорошее"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardStateImageCardView"
            />

        <TextView
            android:id="@+id/cardStateMoodTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/onSurface"
            android:layout_marginStart="4dp"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:text="настроение"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardStateChangeMoodTV"
            />

        <TextView
            android:id="@+id/cardStateCreationDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Сегодня в 12:13"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/onSurface"
            app:layout_constraintTop_toBottomOf="@id/cardStateChangeMoodTV"
            app:layout_constraintStart_toEndOf="@id/cardStateImageCardView"
            />

        <ImageButton
            android:id="@+id/cardStateChangeDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_card_state_dots"
            android:contentDescription="Иконка, при нажатии показывающая выпадающее меню"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="0dp"
            android:background="android:color/transparent"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cardStateFirstRV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            tools:listitem="@layout/card_state_tag"
            tools:itemCount="3"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:spanCount="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardStateCreationDate"
            app:layout_constraintEnd_toStartOf="@id/cardStateChangeDots"/>
        
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cardStateSecondRV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:listitem="@layout/card_state_tag"
            tools:itemCount="2"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:spanCount="2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardStateFirstRV"
            app:layout_constraintEnd_toStartOf="@id/cardStateChangeDots"/>
        
        <TextView
            android:id="@+id/cardStateDescriptionTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/onSurface"
            app:layout_constraintTop_toBottomOf="@id/cardStateSecondRV"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="dfgsdgsdgdgsdfgsdfgsdfgsdfgsdgjsdgshdfgjkhsdkghsdfgjksdklgjgdskjlfg"
            />
        
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>