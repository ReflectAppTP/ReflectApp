<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/aiCardMessageCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/aiCardMessageMarginHorizontal_10dp"
        android:layout_marginVertical="@dimen/aiCardMessageMarginVertical_12dp"
        android:layout_gravity="end"
        app:strokeColor="@color/onSurface"
        app:cardBackgroundColor="@color/onPrimaryContainer"
        app:cardCornerRadius="@dimen/aiCardMessageCornerRadius_12dp"
        app:cardElevation="@dimen/aiCardMessageElevation_4dp"
        >

        <TextView
            android:id="@+id/aiCardMessageTV"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/aiCardMessageTVMargin_16dp"
            android:maxWidth="@dimen/aiCardMessageMaxWidth_250dp"
            android:textColor="@color/onSurface"
            android:textAlignment="textStart"
            tools:text="Ваш запрос ии ассистенту"
            />

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
