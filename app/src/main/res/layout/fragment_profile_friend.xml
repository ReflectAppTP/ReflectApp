<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.screens.profile.fragment.ProfileFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/fragmentProfileToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:layout_marginEnd="@dimen/mainFragmentViewPagerToolbarMarginHorizontal_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/registrationBackArrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Иконка воврата на экран друзей"
            android:src="@drawable/ic_back_arrow"
            android:background="@drawable/rounded_surface_ripple"
            android:layout_gravity="start"
            />
        <ImageButton
            android:id="@+id/fragmentProfileToolbarSettingsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="Иконка дополнительного меню во фрагменте профиля пользователя"
            android:background="@drawable/rounded_surface_ripple"
            android:src="@drawable/ic_horizontal_dots"
            />
    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/fragmentProfileImageCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragmentProfileCardMarginTop_15dp"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        android:elevation="@dimen/fragmentProfileCardElevation_0dp"
        app:cardElevation="@dimen/fragmentProfileCardElevation_0dp"
        app:layout_constraintTop_toBottomOf="@id/fragmentProfileToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/fragmentProfileImageView"
            android:layout_width="@dimen/fragmentProfileImageSize_100dp"
            android:layout_height="@dimen/fragmentProfileImageSize_100dp"
            android:src="@drawable/profile_image"
            android:scaleType="centerCrop"
            android:contentDescription="@string/contentDescriptionFragmentProfileIcon"
            />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/fragmentProfileUserLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/fragmentProfileTitleMarginHorizontal_20dp"
        android:layout_marginTop="@dimen/fragmentProfileTitleMarginTop_10dp"
        android:gravity="center"
        android:textColor="@color/onSurface"
        style="@style/TextAppearance.Material3.TitleLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfileImageCardView"
        tools:text="Пользователь"/>

    <ImageView
        android:id="@+id/fragmentProfileUserPremiumIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_premium_profile"
        android:layout_marginStart="@dimen/fragmentProfilePremiumIconMarginStart_4dp"
        android:layout_marginTop="@dimen/fragmentProfilePremiumIconMarginTop"
        android:visibility="gone"
        android:contentDescription="@string/contentDescriptionCardFriendPremiumIcon"
        app:layout_constraintStart_toEndOf="@id/fragmentProfileUserLogin"
        app:layout_constraintTop_toTopOf="@id/fragmentProfileUserLogin"
        app:layout_constraintBottom_toBottomOf="@id/fragmentProfileUserLogin"
        />
    
    <FrameLayout
        android:id="@+id/fragmentProfileUserAddFriendContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragmentProfileUserLogin"
        >

        <Button
            android:id="@+id/fragmentProfileUserAddFriendButton"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/aiPrimary98"
            android:text="Добавить в друзья"
            app:icon="@drawable/ic_user_add_to_friend"
            />

        <Button
            android:id="@+id/fragmentProfileUserAddFriendButtonSendRequest"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/aiPrimary98"
            android:text="Заявка отправлена"
            app:icon="@drawable/ic_check"
            android:visibility="gone"
            />

        <Button
            android:id="@+id/fragmentProfileUserAddFriendButtonFriend"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="У вас в друзьях"
            app:icon="@drawable/ic_user_friend"
            android:visibility="gone"
            />

        <Button
            android:id="@+id/fragmentProfileUserAddFriendButtonBanned"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пользователь заблокирован"
            android:textColor="@color/onSurface"
            android:backgroundTint="@color/secondaryFixedDim"
            app:icon="@drawable/ic_user_banned"
            app:iconTint="@color/onSurface"
            android:visibility="gone"
            />

    </FrameLayout>
    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fragmentProfileUserContentRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fragmentProfileUserAddFriendContainer"
        >

        <androidx.core.widget.NestedScrollView
            android:id="@+id/fragmentProfileUserContentRootScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/fragmentProfileUserContentLastRecordTitle"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Последняя запись за сегодня"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    />
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/fragmentProfileUserContentLastRecordRV"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="7dp"
                    tools:listitem="@layout/card_state"
                    tools:itemCount="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fragmentProfileUserContentLastRecordTitle"
                    />

                <TextView
                    android:id="@+id/fragmentProfileUserContentStatisticTitle"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Статистика за неделю"
                    android:textColor="@color/onSurface"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fragmentProfileUserContentLastRecordRV"
                    />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fragmentProfileUserContentStatisticLineChartCard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fragmentStatisticCardHeight_300dp"
                    app:cardElevation="@dimen/fragmentStatisticCardElevation_2dp"
                    android:layout_marginHorizontal="23dp"
                    android:layout_marginTop="15dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fragmentProfileUserContentStatisticTitle"
                    >

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        >

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/fragmentProfileUserContentStatisticLottieLineChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:lottie_rawRes="@raw/loading_animation"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true" />

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/fragmentProfileUserContentStatisticLineChart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/fragmentProfileUserContentStatisticLineChartCard"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
        
        <TextView
            android:id="@+id/fragmentProfileUserContentHideTitle"
            style="@style/TextAppearance.Material3.LabelLarge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:visibility="gone"
            android:text="Информация о записях скрыта"
            android:textColor="@color/onSurface"
            />
        
    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>