<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.screens.profile.fragment.ProfileFragment">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/fragmentProfileToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:layout_marginHorizontal="@dimen/mainFragmentViewPagerToolbarMarginHorizontal_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/fragmentProfileToolbarSettingsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:contentDescription="@string/contentDescriptionToolbarSettingsIcon"
            android:background="@color/surface"
            android:src="@drawable/ic_settings_toolbar"
            />

    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/fragmentProfileImageCardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="@color/background"
        android:backgroundTint="@color/background"
        android:elevation="0dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/fragmentProfileToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <ImageView
            android:id="@+id/fragmentProfileImageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/profile_image"
            android:scaleType="centerCrop"
            android:contentDescription="@string/contentDescriptionFragmentProfileIcon"
            />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_change_profile_image"
            android:contentDescription="@string/contentDescriptionFragmentProfileIconChange"
            android:layout_margin="4dp"
            />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/fragmentProfileUserLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/onSurface"
        style="@style/TextAppearance.Material3.TitleLarge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfileImageCardView"
        tools:text="Пользователь"/>

    <Button
        android:id="@+id/fragmentProfilePremiumButton"
        android:layout_width="@dimen/fragmentProfileButtonWidth_255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragmentProfileButtonMarginTop_20dp"
        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
        android:text="@string/fragmentProfilePremiumButton"
        android:textAlignment="textStart"
        android:textColor="@color/onSurface"
        android:paddingVertical="@dimen/fragmentProfileButtonPaddingVertical_12dp"
        app:icon="@drawable/ic_profile_premium"
        app:iconTint="@color/onSurface"
        app:iconPadding="@dimen/fragmentProfileButtonIconPadding_8dp"
        app:cornerRadius="@dimen/fragmentProfileButtonCornerRadius_12dp"
        app:strokeColor="@color/primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfileUserLogin" />

    <Button
        android:id="@+id/fragmentProfileWidgetButton"
        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
        android:layout_width="@dimen/fragmentProfileButtonWidth_255dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragmentProfileButtonMarginTop_20dp"
        android:paddingVertical="@dimen/fragmentProfileButtonPaddingVertical_12dp"
        android:text="@string/fragmentProfileWidgetButton"
        android:textAlignment="textStart"
        android:textColor="@color/onSurface"
        app:cornerRadius="@dimen/fragmentProfileButtonCornerRadius_12dp"
        app:icon="@drawable/ic_profile_widget"
        app:iconPadding="@dimen/fragmentProfileButtonIconPadding_8dp"
        app:iconTint="@color/onSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfilePremiumButton"
        app:strokeColor="@color/primary" />

    <Button
        android:id="@+id/fragmentProfileLogoutButton"
        android:layout_width="@dimen/fragmentProfileSmallButtonWidth_180dp"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginTop="@dimen/fragmentProfileButtonMarginTop_20dp"
        android:text="@string/fragmentProfileLogoutButton"
        android:textColor="@color/onSurface"
        app:cornerRadius="@dimen/fragmentProfileButtonCornerRadius_12dp"
        app:strokeColor="@color/primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfileWidgetButton" />

    <Button
        android:id="@+id/fragmentProfileLoginButton"
        android:layout_width="@dimen/fragmentProfileSmallButtonWidth_180dp"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_marginTop="@dimen/fragmentProfileButtonMarginTop_20dp"
        android:text="@string/fragmentProfileLoginButton"
        android:textColor="@color/onSurface"
        app:cornerRadius="@dimen/fragmentProfileButtonCornerRadius_12dp"
        app:strokeColor="@color/primary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfileWidgetButton" />

    <Button
        android:id="@+id/fragmentProfileRegistrationButton"
        android:layout_width="@dimen/fragmentProfileSmallButtonWidth_180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fragmentProfileButtonMarginTop_10dp"
        android:text="@string/fragmentProfileRegistrationButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragmentProfileLoginButton" />


</androidx.constraintlayout.widget.ConstraintLayout>