<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/cardFriendMarginHorizontal_26dp"
    android:layout_marginVertical="@dimen/cardFriendMarginVertical_7dp"
    app:cardBackgroundColor="@color/aiPrimary98"
    app:strokeWidth="@dimen/cardFriendStrokeWidth_1dp"
    app:strokeColor="@color/onSurface"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/cardFriendConstraintLayoutMargin_16dp"
        >

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFriendIconMaterialCard"
            android:layout_width="@dimen/cardFriendIconSize_40dp"
            android:layout_height="@dimen/cardFriendIconSize_40dp"
            app:cardBackgroundColor="@color/primary"
            app:cardElevation="@dimen/cardFriendIconElevation_0dp"
            app:cardCornerRadius="@dimen/cardFriendIconCornerRadius_45dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/cardFriendIconMaterialCardText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/onPrimaryContainer"
                android:textSize="@dimen/cardFriendIconTextSize_18sp"
                tools:text="A"
                />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/cardFriendLogin"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/cardFriendLoginMarginStart_16dp"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/onSurface"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardFriendIconMaterialCard"
            tools:text="Максим качков"
            />

        <TextView
            android:id="@+id/cardFriendNotificationRequest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cardFriendLoginMarginStart_16dp"
            android:text="@string/cardFriendNotificationRequestText"
            android:textColor="@color/onSurface"
            android:layout_marginTop="@dimen/cardFriendNotificationRequestMarginTop_4dp"
            style="@style/TextAppearance.Material3.TitleSmall"
            app:layout_constraintStart_toEndOf="@id/cardFriendIconMaterialCard"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardFriendLogin"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>